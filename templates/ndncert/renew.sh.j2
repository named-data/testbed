#!/bin/bash

set -e
source "$(pwd)/scripts/utils.sh"
cd "$(dirname "${BASH_SOURCE[0]}")"

# Variables
KEY_NAME="{{ default_prefix }}"
ROOT_CA_HTTPS="{{ root_ca_https }}"
ROOT_CA_SECRET="{{ ROOT_CA_SECRET | trim }}"

# Paths
WORKING_DIR="$(pwd)"
NDNCERT_CERTFILE="${WORKING_DIR}/site.ndncert"

# NDNCERT certificate
if [[ $(needs_renewal "${NDNCERT_CERTFILE}") ]]; then
  export HOME="${WORKING_DIR}"
  get_csr "${KEY_NAME}" > "${NDNCERT_CERTFILE}.csr"

  RENEW_CERTFILE=$(mktemp "${NDNCERT_CERTFILE}.renew.XXXXXX")
  trap 'rm -f "${RENEW_CERTFILE}"' EXIT

  # Get certificate from root certificate authority
  curl -fsSL -X POST -H "Authorization: Bearer ${ROOT_CA_SECRET}" \
      --upload-file "${NDNCERT_CERTFILE}.csr" -o "${RENEW_CERTFILE}" \
      "${ROOT_CA_HTTPS}/sign"

  # Install certificate to keychain
  ndnsec cert-install -f "${RENEW_CERTFILE}"
  mv -f "${RENEW_CERTFILE}" "${NDNCERT_CERTFILE}"
  touch "${WORKING_DIR}/.security-changed"
fi

renew_cleanup
