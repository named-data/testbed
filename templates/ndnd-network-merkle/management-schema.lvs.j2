// Root -> user, or root -> site -> user/log; only the local log signs responses.
#key: "KEY"/_/_/_
#root: {{ ndn_lvs_name(ndnd_dv_network) }}/#key
{% for depth in range(1, 7) %}
#root_user_{{ depth }}: {{ ndn_lvs_name(ndnd_dv_network) }}{% for n in range(depth) %}/rootuser{{ n }}{% endfor %}

#root_user_key_{{ depth }}: #root_user_{{ depth }}/#key <= #root
#root_append_{{ depth }}: {{ ndn_lvs_name(ndnd_router_prefix + '/merkle') }}/"32=append"/#root_user_{{ depth }}/_ <= #root_user_key_{{ depth }}
{% endfor %}
{% for host, values in hostvars.items() %}
{% if values.get('ndnd_enabled', false) %}
{% set site_id = loop.index %}
#site_{{ site_id }}: {{ ndn_lvs_name(values.ndnd_ca_prefix) }}/#key <= #root
{% for depth in range(1, 6) %}
{% set id = site_id ~ '_' ~ depth %}
#user_{{ id }}: {{ ndn_lvs_name(values.ndnd_ca_prefix) }}{% for n in range(depth) %}/user{{ n }}{% endfor %}

#user_key_{{ id }}: #user_{{ id }}/#key <= #site_{{ site_id }}
#append_{{ id }}: {{ ndn_lvs_name(ndnd_router_prefix + '/merkle') }}/"32=append"/#user_{{ id }}/_ <= #user_key_{{ id }}
{% endfor %}
{% if host == inventory_hostname %}
#log_key: {{ ndn_lvs_name(ndnd_router_prefix + '/merkle') }}/#key <= #site_{{ site_id }}
{% endif %}
{% endif %}
{% endfor %}
// Object validation removes terminal version and segment components.
#append_response: {{ ndn_lvs_name(ndnd_router_prefix + '/merkle') }}/"32=append"/_ <= #log_key
#check_response: {{ ndn_lvs_name(ndnd_router_prefix + '/merkle') }}/"32=check"/_ <= #log_key
