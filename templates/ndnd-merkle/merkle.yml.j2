merkle:
  name: {{ (default_prefix + '/ndnd/merkle') | tojson }}
  storage_dir: /config/storage
  max_entries: 1000000
  keychain: dir:///config/keys
  trust_schema: /config/management-schema.tlv
  trust_anchors:
    {% for anchor in ndnd_repo_anchors %}
    - {{ ndn_cert_name(read_file(anchor)) | tojson }}
    {% endfor %}
