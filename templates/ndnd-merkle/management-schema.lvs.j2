// Root -> user, or root -> site -> certified requester; only the local log signs responses.
#key: "KEY"/_/_/_
#root: {{ ndn_lvs_name(ndnNetwork) }}/#key
// Current NDNCERT names are one user component below the network prefix.
#flat_user: {{ ndn_lvs_name(ndnNetwork) }}/user
#flat_user_key: #flat_user/#key <= #root
#flat_append: {{ ndn_lvs_name(default_prefix + '/ndnd/merkle') }}/"32=append"/#flat_user/_ <= #flat_user_key
{% for host, values in hostvars.items() %}
{% set site_id = loop.index %}
#site_{{ site_id }}: {{ ndn_lvs_name(values.default_prefix) }}/#key <= #root
#flat_user_key: #flat_user/#key <= #site_{{ site_id }}
{% for depth in range(1, 6) %}
{% set id = site_id ~ '_' ~ depth %}
#user_{{ id }}: {{ ndn_lvs_name(values.default_prefix) }}{% for n in range(depth) %}/user{{ n }}{% endfor %}

#user_key_{{ id }}: #user_{{ id }}/#key <= #site_{{ site_id }}
#append_{{ id }}: {{ ndn_lvs_name(default_prefix + '/ndnd/merkle') }}/"32=append"/#user_{{ id }}/_ <= #user_key_{{ id }}
{% endfor %}
{% if host == inventory_hostname %}
#log_key: {{ ndn_lvs_name(default_prefix + '/ndnd/merkle') }}/#key <= #site_{{ site_id }}
{% endif %}
{% endfor %}
// Object validation removes terminal version and segment components.
#append_response: {{ ndn_lvs_name(default_prefix + '/ndnd/merkle') }}/"32=append"/_ <= #log_key
#check_response: {{ ndn_lvs_name(default_prefix + '/ndnd/merkle') }}/"32=check"/_ <= #log_key
