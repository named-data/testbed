{
  "ca-prefix": {{ ndnd_dv_network | tojson }},
  "ca-info": {{ ndnd_ca_info | tojson }},
  "max-validity-period": {{ ndnd_ca_max_validity_period | tojson }},
  "supported-challenges": [
    {% for challenge in ndnd_ca_supported_challenges %}{ "challenge": {{ challenge | tojson }} }{% if not loop.last %},{% endif %}{% endfor %}
  ],
  "email": {
    "smtp-server": {{ SMTP_SERVER | tojson }},
    "smtp-port": 587,
    "smtp-username": {{ SMTP_USER | tojson }},
    "smtp-password-env": "NDND_SMTP_PASSWORD",
    "from": "NDN Certificate Robot <noreply@ndncert.named-data.net>",
    "subject": "Your NDNCERT verification code"
  }
}
